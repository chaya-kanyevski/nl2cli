# מפתח API לספק LLM תואם OpenAI
LLM_API_KEY=sk-...

# מודל (ברירת מחדל: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# אופציונלי: כתובת בסיס לספק אחר תואם OpenAI.
# לדוגמה Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=

# טמפרטורה 0 = תשובות יציבות ועקביות
LLM_TEMPERATURE=0

# שם האימג' של ה-sandbox (בונוס)
SANDBOX_IMAGE=nl2cli-sandbox
